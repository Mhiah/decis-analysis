# Qwen via Alibaba Cloud Model Studio (OpenAI-compatible). Copy to .env.local.
# Without a key the Ask panel keeps its deterministic answers.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
# Mainland China accounts: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
